ASSERT VERSION.BUILD()>=97333. "Required TRACE32 build 97333 or newer"

ASSERT CPUFAMILY()=="RISCV" "Use this peripheral file with TRACE32 for RISC-V"

ASSERT VERSION.BUILD.BASE()>=80109.

sif PER.isNOTIFICATION()
  base AVM:0x00000000
  wgroup AVM:0x00++0
    textline " Peripheral File Notification - "
    button "show missing files" "DIALOG.MESSAGE ""Please check your installation for the possibly missing files:""+CONV.CHAR(0xa)+PER.NOTIFICATION.MISSINGFILES()"
    textline " ---------------------------------------------------------------"
    textline " The peripheral file for this SoC cannot be displayed.          "
    textline " Possible reasons are:                                          "
    textline " - it is missing in the local installation or under development "
    textline " - it is confidential                                           "
    textline "                                                                "
    textline " As fallback only the core registers are shown.                 "
    textline " Please check    www.lauterbach.com/scripts.html                "
    textline " or contact      support@lauterbach.com .                       "
    textline "                                                                "
endif
WAIT

tree "Control and Status Registers (CSR)"
    base CSR:0x00000000
SIF (!CPUIS64BIT())
AUTOINDENT.ON CENTER TREE
tree "Customized CSRs in the Nuclei processor core"
  group.long (0x307*4)++3.
      line.long 0x00 "MTVT,ECLIC Interrupt Vector Table Base Address"
  group.long (0x346*4)++3.
      line.long 0x00 "MINTSTATUS,Current Interrupt Level. mintstatus register"
          bitfld.long 0x00 24.--31. "MIL,The active interrupt level in machine mode"
          newline
          bitfld.long 0x00 0.--7. "UIL,The active interrupt level in user mode"
  group.long (0x348*4)++3.
      line.long 0x00 "MSCRATCHCSW,Scratch swap register for privileged mode"
  group.long (0x349*4)++3.
      line.long 0x00 "MSCRATCHCSWL,Scratch swap register for privileged mode"
  group.long (0x390*4)++3.
      line.long 0x00 "MLWID,WorldGuard for security"
  group.long (0x5F0*4)++3.
      line.long 0x00 "SATTRI0_BASE,Base address of Secure Region 0 to set attribute"
          bitfld.long 0x00 0. "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x5F1*4)++3.
      line.long 0x00 "SATTRI0_MASK,Mask(size) of Secure Region 0 to set attribute"
  group.long (0x5F2*4)++3.
      line.long 0x00 "SATTRI1_BASE,Base address of Secure Region 1 to set attribute"
          bitfld.long 0x00 0. "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x5F3*4)++3.
      line.long 0x00 "SATTRI1_MASK,Mask(size) of Secure Region 1 to set attribute"
  group.long (0x5F4*4)++3.
      line.long 0x00 "SATTRI2_BASE,Base address of Secure Region 2 to set attribute"
          bitfld.long 0x00 0. "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x5F5*4)++3.
      line.long 0x00 "SATTRI2_MASK,Mask(size) of Secure Region 2 to set attribute"
  group.long (0x5F6*4)++3.
      line.long 0x00 "SATTRI3_BASE,Base address of Secure Region 3 to set attribute"
          bitfld.long 0x00 0. "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x5F7*4)++3.
      line.long 0x00 "SATTRI3_MASK,Mask(size) of Secure Region 3 to set attribute"
  group.long (0x5F8*4)++3.
      line.long 0x00 "SATTRI4_BASE,Base address of Secure Region 4 to set attribute"
          bitfld.long 0x00 0. "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x5F9*4)++3.
      line.long 0x00 "SATTRI4_MASK,Mask(size) of Secure Region 4 to set attribute"
  group.long (0x5FA*4)++3.
      line.long 0x00 "SATTRI5_BASE,Base address of Secure Region 5 to set attribute"
          bitfld.long 0x00 0. "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x5FB*4)++3.
      line.long 0x00 "SATTRI5_MASK,Mask(size) of Secure Region 5 to set attribute"
  group.long (0x5FC*4)++3.
      line.long 0x00 "SATTRI6_BASE,Base address of Secure Region 6 to set attribute"
          bitfld.long 0x00 0. "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x5FD*4)++3.
      line.long 0x00 "SATTRI6_MASK,Mask(size) of Secure Region 6 to set attribute"
  group.long (0x5FE*4)++3.
      line.long 0x00 "SATTRI7_BASE,Base address of Secure Region 7 to set attribute"
          bitfld.long 0x00 0. "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x5FF*4)++3.
      line.long 0x00 "SATTRI7_MASK,Mask(size) of Secure Region 7 to set attribute"
  group.long (0x7C0*4)++3.
      line.long 0x00 "MILM_CTL,Enable/Disabled the ILM address space. milm_ctl register"
          bitfld.long 0x00 10.--31. "ILM_BPA,The base physical address of ILM"
          newline
          bitfld.long 0x00 6. "DIS_LSU_ILM,Disabled LSU access ILM" "Enabled,Disabled"
          newline
          bitfld.long 0x00 5. "ILM_VA_EN,Use virtual address for ILM access" "Not used,Used"
          newline
          bitfld.long 0x00 4. "ILM_ECC_CHK_EN,Controls to check the ECC Code or not when core access to ILM." "Disabled,Enabled"
          newline
          bitfld.long 0x00 3. "ILM_ECC_INJ_EN,Controls to inject the ECC Code in CSR mecc_code to ILM" "Disabled,Enabled"
          newline
          bitfld.long 0x00 2. "ILM_ECC_EXCP_EN,ILM double bit ECC exception enable control" "No exception,Exception"
          newline
          bitfld.long 0x00 1. "ILM_ECC_EN,ILM ECC feature enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 0. "ILM_ENABLE,Instruction Local Memory enable bit" "Disabled,Enabled"
  group.long (0x7C1*4)++3.
      line.long 0x00 "MDLM_CTL,Enable/Disabled the DLM address space. mdlm_ctl register"
          bitfld.long 0x00 10.--31. "DLM_BPA,The base physical address of DLM"
          newline
          bitfld.long 0x00 5. "DIS_LSU_DLM,Disabled LSU access DLM" "Enabled,Disabled"
          newline
          bitfld.long 0x00 4. "DLM_ECC_CHK_EN,Controls to check the ECC Code or not when core access to DLM" "Disabled,Enabled"
          newline
          bitfld.long 0x00 3. "DLM_ECC_INJ_EN,Controls to inject the ECC Code in CSRmecc_code to DLM" "Disabled,Enabled"
          newline
          bitfld.long 0x00 2. "DLM_ECC_EXCP_EN,DLM double bit ECC exception enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 1. "DLM_ECC_EN,DLM ECC enable feature control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 0. "DLM_ENABLE,Data Local Memory enable bit" "Disabled,Enabled"
  group.long (0x7C2*4)++3.
      line.long 0x00 "MECC_CODE,ECC code injection register, can be used to simulate ECC error.mecc_code register"
          bitfld.long 0x00 24.--28. "SRAMID,The ID of RAM that has single bit ECC errors" "I-Cache,D-Cache,Main TLB,ILM,DLM"
          newline
          bitfld.long 0x00 16.--20. "RAMID,The ID of RAM that has double bit ECC errors" "I-Cache,D-Cache,Main TLB,ILM,DLM"
          newline
          bitfld.long 0x00 9.--15.  "RSVD,Reserved"
          newline
          bitfld.long 0x00 0.--8.   "CODE,ECC code for injection"
  group.long (0x7C3*4)++3.
      line.long 0x00 "MNVEC,Customized register used to indicate the NMI handler entry address"
  group.long (0x7C4*4)++3.
      line.long 0x00 "MSUBM,Customized register storing current trap type and the previous.msubm register trap type before trapped"
          bitfld.long 0x00 8.--9. "PTYP,Machine sub-mode before entering the trap" "Normal Machine Mode,Interrupt Handling Mode,Exception Handling Mode,NMI Handling Mode"
          newline
          bitfld.long 0x00 6.--7. "TYP,Current sub-mode" "Normal Machine Mode,Interrupt Handling Mode,Exception Handling Mode,NMI Handling Mode"
  group.long (0x7C6*4)++3.
      line.long 0x00 "MSTACK_CTL,Customized register to control Stack Check function.mstack_ctl register"
          bitfld.long 0x00 2. "MODE,Mode of stack checking" "Overflow and Underflow check,Track the stack top"
          newline
          bitfld.long 0x00 1. "UDF_EN,Stack underflow check enable" "Disabled,Enabled"
          newline
          bitfld.long 0x00 0. "OVF_TRACK_EN,Stack overflow check or track enable" "Disabled,Enabled"
  group.long (0x7C7*4)++3.
      line.long 0x00 "MSTACK_BOUND,Customized register to store the bound of or track stack top for Stack Check. mstack_bound register"
          bitfld.long 0x00 0.--31. "BOUND,Stack top’s value for stack overflow check or track (Default value is all ones)"
  group.long (0x7C8*4)++3.
      line.long 0x00 "MSTACK_BASE,Customized register to store the stack base for Stack Check.mstack_base register"
          bitfld.long 0x00 0.--31. "BASE,Stack base’s value for stack underflow check (Default value is all ones)"
  group.long (0x7C9*4)++3.
      line.long 0x00 "MDCAUSE,Customized register storing current trap’s detailed cause. mdcause register"
      if (((per.l(CSR:0x342))&0xFFF)==1.)
          group.long (0x7C9*4)++3.
          bitfld.long 0x00 0.--2. "MDCAUSE,Instruction access fault detail" ",PMP  permission violation,Bus error,,,,,ECC error"
      elif (((per.l(CSR:0x342))&0xFFF)==5.)
          group.long (0x7C9*4)++3.
          bitfld.long 0x00 0.--2. "MDCAUSE,Load access fault detail" ",PMP permission violation bus error,Bus error caused by core memory read,Bus error caused by NICE write back,,,,ECC error"
      elif (((per.l(CSR:0x342))&0xFFF)==7.)
          group.long (0x7C9*4)++3.
          bitfld.long 0x00 0.--2. "MDCAUSE,Store/AMO access fault detail" ",PMP permission violation bus error,Bus error caused by core memory write,,,,,ECC error"
      elif (((per.l(CSR:0x342))&0xFFF)==12.)
          group.long (0x7C9*4)++3.
          bitfld.long 0x00 0.--2. "MDCAUSE,Instruction page fault detail" ",,,,,MMU fault,SMPU fault,ECC error"
      elif (((per.l(CSR:0x342))&0xFFF)==13.)
          group.long (0x7C9*4)++3.
          bitfld.long 0x00 0.--2. "MDCAUSE,Load page fault detail" ",,,,,MMU fault,Load page fault bus error caused by SMPU,ECC error"
      elif (((per.l(CSR:0x342))&0xFFF)==15.)
          group.long (0x7C9*4)++3.
          bitfld.long 0x00 0.--2. "MDCAUSE,Store page fault detail" ",,,,,MMU fault,Store page fault bus error caused by SMPU,ECC error"
      endif
  group.long (0x7CA*4)++3.
      line.long 0x00 "MCACHE_CTL,Customized register to control the Cache features"
          bitfld.long 0x00 23. "DC_BURST_TYPE,D-Cache Burst type control" "WRAP,INCR"
          newline
          bitfld.long 0x00 22. "DC_PREFETCH_EN,D-Cache CMO prefetch enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 21. "DC_ECC_CHK_EN,Controls to check the ECC Code when core access to D-Cache" "Disabled,Enabled"
          newline
          bitfld.long 0x00 20. "DC_DRAM_ECC_INJ_EN,Controls to inject the ECC Code in CSR mecc_code to D-Cache data rams" "Disabled,Enabled"
          newline
          bitfld.long 0x00 19. "DC_TRAM_ECC_INJ_EN,Controls to inject the ECC Code in CSR mecc_code to D-Cache tag rams" "Disabled,Enabled"
          newline
          bitfld.long 0x00 18. "DC_ECC_EXCP_EN,D-Cache double bit ECC exception enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 17. "DC_ECC_EN,D-Cache ECC enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 16. "DC_EN,D-Cache enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 10. "IC_BURST_TYPE,I-Cache Burst type control" "WRAP,INCR"
          newline
          bitfld.long 0x00 9. "IC_PREFETCH_EN,I-Cache CMO prefetch enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 8. "IC_ECC_CHK_EN,Controls to check the ECC when core access to I-Cache" "Disabled,Enabled"
          newline
          bitfld.long 0x00 7. "IC_CANCEL_EN,I-Cache change flow canceling enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 6. "IC_PF_EN,I-Cache prefetch enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 5. "IC_DRAM_ECC_INJ_EN,Controls to inject the ECC Code in CSR mecc_code to I-Cache data rams" "Disabled,Enabled"
          newline
          bitfld.long 0x00 4. "IC_TRAM_ECC_INJ_EN,Controls to inject the ECC Code in CSR mecc_code to I-Cache tag rams" "Disabled,Enabled"
          newline
          bitfld.long 0x00 3. "IC_ECC_EXCP_EN,I-Cache double bit ECC exception enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 2. "IC_ECC_EN,I-Cache ECC enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 1. "IC_SCPD_MOD,I-Cache Scratchpad Mode enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 0. "IC_EN,I-Cache enable control" "Disabled,Enabled"
  group.long (0x7D0*4)++3.
      line.long 0x00 "MMISC_CTL,Customized register controlling the selection of the NMI Handler"
          bitfld.long 0x00 17. "CSR_EXCL_ENABLE,Exclusive instruction(lr,sc) on Non-cacheable/Device memory can send exclusive flag in memory bus" "Disabled,Enabled"
          newline
          bitfld.long 0x00 12. "LDSPEC_ENABLE,Enable or disable the Load Speculative goes to Mem Interface" "Disabled,Enabled"
          newline
          bitfld.long 0x00 11. "SIUMP_ENABLE,Control the SIUMP mode of trace if Encoder inside Core" "Disabled,Enabled"
          newline
          bitfld.long 0x00 10. "IMRETURN_ENABLE,Control the IMRETURN mode of trace if Encoder inside Core" "Disabled,Enabled"
          newline
          bitfld.long 0x00 9. "NMI_CAUSE_FFF,Control mvec and mcause.EXCODE of NMI" "mnvec = PC address && mcause.EXCCODE of NMI is 0x1,mnvec = mtvec && mcause.EXCCODE of NMI is 0xfff"
          newline
          bitfld.long 0x00 8. "CORE_BUS_ERR,Control the bus error caused by core is exception or interrupt" "Exception,Interrupt"
          newline
          bitfld.long 0x00 7. "ZCMT_ZCMP_EN,Control the ZCMP and ZCMT Ext uses the Zcd extension encoding or not" "Zcd encoding,ZCMP and ZCMT encoding"
          newline
          bitfld.long 0x00 6. "UNAGING_ENABLE,Enable or disable misaligned load/store access" "Disabled,Enabled"
          newline
          bitfld.long 0x00 3. "BPU_ENABLE,Enable or disable the BPU Unit" "Disabled,Enabled"
          newline
          bitfld.long 0x00 1. "ZCLSD_EN,Control the Zclsd will uses the Zcf extension encoding or not" "Zcf,Zclsd"
  group.long (0x7DD*4)++3.
      line.long 0x00 "MTLB_CTL,Customized register to control the TLB"
          bitfld.long 0x00 7 "NAPOT_EN,Napot page enable" "Disabled,Enabled"
          newline
          bitfld.long 0x00 6 "TLB_ECC_CHK_EN,Controls to check the ECC when core access to MTLB" "Disabled,Enabled"
          newline
          bitfld.long 0x00 3 "TLB_DRAM_ECC_INJ_EN,Controls to inject the ECC Code in CSR mecc_code to MTLB data rams" "Disabled,Enabled"
          newline
          bitfld.long 0x00 2 "TLB_TRAM_ECC_INJ_EN,Controls to inject the ECC Code in CSR mecc_code to MTLB tag rams" "Disabled,Enabled"
          newline
          bitfld.long 0x00 1 "TLB_ECC_EXCP_EN,MTLB double bit ECC exception enable control" "Disabled,Enabled"
          newline
          bitfld.long 0x00 0 "TLB_ECC_EN,MTLB ECC enable control" "Disabled,Enabled"
  group.long (0x7DE*4)++3.
      line.long 0x00 "MECC_LOCK,To lock ECC configure registers,then all the ECC related CSRs cannot"
          bitfld.long 0x00 0. "ECC_LOCK,To lock ECC related CSRs" "Not locked,locked"
  group.long (0x7E2*4)++3.
      line.long 0x00 "MMISC_CTL1,Customized register used to set 16 bit float precision mode"
          bitfld.long 0x00 6. "RVV_VL_0_CMPT,Control some vpu instruction behaviour is compatible with rvv1.0" "Not compatible,Compatible"
          newline
          bitfld.long 0x00 5. "VLM_PATH_EN,Control vlm dedicated path enable" "Disabled,Enabled"
          newline
          bitfld.long 0x00 4. "VLSU_COF_EN,Control the enable of vlsu check-only first feature" "Disabled,Enabled"
          newline
          bitfld.long 0x00 3. "VLSU_OOO_EN,Control the enable of vlsu ooo feature" "Disabled,Enabled"
          newline
          bitfld.long 0x00 2. "VLSU_OOO_FORCE_VA_4K,Control the size of virtual address check region for vlsu ooo" "By vlsu_ooo_4k_mode,Force 4KB"
          newline
          bitfld.long 0x00 1. "VLSU_OOO_4K_MODE,Control the size of address check region for vlsu ooo" "1MB,4KB"
          newline
          bitfld.long 0x00 0. "FP16MODE,16 bit float precision mode" "Normal mode,Bfloat16"
  group.long (0x7EB*4)++3.
      line.long 0x00 "PUSHMSUBM,Customized register used to push the value of msubm into the stack memory"
  group.long (0x7EC*4)++3.
      line.long 0x00 "MTVT2,Customized register used to indicate the common handler entry address of non-vectored interrupts"
          bitfld.long 0x00 2.--31. "COMMON-CODE-ENTRY,When mtvt2.MTVT2EN=1 this field determines the entry address of interrupt common code in ECLIC non-vector mode"
          newline
          bitfld.long 0x00 0. "MTVT2EN,mtvt2 enable" "The entry address determined by mtvec,The entry address determined by mtvt2.COMMON-CODE-ENTRY"
  group.long (0x7ED*4)++3.
      line.long 0x00 "JALMNXTI,Customized register used to enable the ECLIC interrupt.The read operation of this register will take the next interrupt,return the entry address of next interrupt handler,and jump to the corresponding handler at the same time"
  group.long (0x7EE*4)++3.
      line.long 0x00 "PUSHMCAUSE,Customized register used to push the value of mcause into the stack memory"
  group.long (0x7EF*4)++3.
      line.long 0x00 "PUSHMEPC,Customized register used to push the value of mepc into the stack memory"
  group.long (0x7f0*4)++3.
      line.long 0x00 "MPPICFG_INFO,PPI Configuration Information"
          bitfld.long 0x00 10.--31. "PPI_BPA,The base physical address of PPI and has to be aligned to multiple of PPI size"
          newline
          bitfld.long 0x00 9. "PPI_EN,PPI Enable" "Disabled,Enabled"
          newline
          bitfld.long 0x00 1.--5. "PPI_SIZE,Indicates the size of PPI and it should be power of 2" ",1KB,2KB,4KB,8KB,16KB,32KB,64KB,128KB,256KB,512KB,1MB,2MB,4MB,8MB,16MB,32MB,64MB,128MB,256MB,512MB,1GB,2GB,?..."
          newline
          bitfld.long 0x00 0. "RSVD,Reserved" "1"
  group.long (0x7F1*4)++3.
      line.long 0x00 "MFIOCFG_INFO,FIO Configuration Information"
          bitfld.long 0x00 10.--31. "FIO_BPA,The base physical address of FIO and has to be aligned to multiple of FIO size"
          newline
          bitfld.long 0x00 1.--5. "FIO_SIZE,Indicates the size of FIO and it should be power of 2" ",1KB,2KB,4KB,8KB,16KB,32KB,64KB,128KB,256KB,512KB,1MB,2MB,4MB,8MB,16MB,32MB,64MB,128MB,256MB,512MB,1GB,2GB,?..."
          newline
          bitfld.long 0x00 0. "RSVD,Reserved" "1"
  group.long (0x7F3*4)++3.
      line.long 0x00 "MATTRI0_BASE,Base address of Region 0 to set attribute"
          bitfld.long 0x00 3 "SecShare,This region is shareable between secure world and non-secure world or not" "Invalid,Shareable"
          newline
          bitfld.long 0x00 2 "NOC,This region is Non cacheable Region or not" "Invalid,Non cacheable"
          newline
          bitfld.long 0x00 1 "DEV,This region is Device Region or not" "Invalid,Device"
          newline
          bitfld.long 0x00 0 "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x7F4*4)++3.
      line.long 0x00 "MATTRI0_MASK,Mask(size) of Region 0 to set attribute"
  group.long (0x7F5*4)++3.
      line.long 0x00 "MATTRI1_BASE,Base address of Region 1 to set attribute"
          bitfld.long 0x00 3 "SecShare,This region is shareable between secure world and non-secure world or not" "Invalid,Shareable"
          newline
          bitfld.long 0x00 2 "NOC,This region is Non cacheable Region or not" "Invalid,Non cacheable"
          newline
          bitfld.long 0x00 1 "DEV,This region is Device Region or not" "Invalid,Device"
          newline
          bitfld.long 0x00 0 "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x7F6*4)++3.
      line.long 0x00 "MATTRI1_MASK,Mask(size) of Region 1 to set attribute"
  group.long (0x7F9*4)++3.
      line.long 0x00 "MATTRI2_BASE,Base address of Region 2 to set attribute"
          bitfld.long 0x00 3 "SecShare,This region is shareable between secure world and non-secure world or not" "Invalid,Shareable"
          newline
          bitfld.long 0x00 2 "NOC,This region is Non cacheable Region or not" "Invalid,Non cacheable"
          newline
          bitfld.long 0x00 1 "DEV,This region is Device Region or not" "Invalid,Device"
          newline
          bitfld.long 0x00 0 "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x7FA*4)++3.
      line.long 0x00 "MATTRI2_MASK,Mask(size) of Region 2 to set attribute"
  group.long (0x7fb*4)++3.
      line.long 0x00 "MATTRI3_BASE,Base address of Region 3 to set attribute"
          bitfld.long 0x00 3 "SecShare,This region is shareable between secure world and non-secure world or not" "Invalid,Shareable"
          newline
          bitfld.long 0x00 2 "NOC,This region is Non cacheable Region or not" "Invalid,Non cacheable"
          newline
          bitfld.long 0x00 1 "DEV,This region is Device Region or not" "Invalid,Device"
          newline
          bitfld.long 0x00 0 "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x7FC*4)++3.
      line.long 0x00 "MATTRI3_MASK,Mask(size) of Region 3 to set attribute"
  group.long (0x7FD*4)++3.
      line.long 0x00 "MATTRI4_BASE,Base address of Region 4 to set attribute"
          bitfld.long 0x00 3 "SecShare,This region is shareable between secure world and non-secure world or not" "Invalid,Shareable"
          newline
          bitfld.long 0x00 2 "NOC,This region is Non cacheable Region or not" "Invalid,Non cacheable"
          newline
          bitfld.long 0x00 1 "DEV,This region is Device Region or not" "Invalid,Device"
          newline
          bitfld.long 0x00 0 "ENA,Region enable control" "Disabled,Enabled"
  group.long (0x7FE*4)++3.
      line.long 0x00 "MATTRI4_MASK,Mask(size) of Region 4 to set attribute"
  group.long (0x7f7*4)++3.
      line.long 0x00 "MIRGB_INFO,IREGION Configuration Information"
